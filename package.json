{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:api": "bun src/main.ts api",
    "start:worker": "bun src/main.ts worker",
    "start:all": "bun src/main.ts all",
    "migrate:up": "bun src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun src/infrastructure/persistence/migrate.ts down",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --preload ./test/support/global-invariants.ts --timeout 60000 test/integration",
    "test:concurrency": "bun test --preload ./test/support/global-invariants.ts --timeout 120000 test/concurrency",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:load": "bun test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "decimal.js": "^10.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.7",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "typescript": "^7.0.2"
  }
}
